#!/bin/sh
# Stub `gh` for the ensemble-retro eval. No network, no GitHub. Answers from canned files in bin/canned/ and logs every call to
# gh-calls.log in the sandbox root (two levels above this stub, outside the git worktree), one line each:
#   OK|REFUSED|UNSUPPORTED|ERROR <argv folded to one line>
# What it knows (like the real CLI where it matters):
#   --version, auth status                         ok
#   repo view [--json ...] [--jq ...]              canned/repo-view.json, or the two .nameWithOwner / .defaultBranchRef.name forms
#   pr list                                        OPEN pull requests only unless --state says otherwise (as the real CLI does)
#     --json F[,F...]                              the canned array, whatever fields are asked for (the real CLI trims the fields)
#     --jq <the host adapter's own expression>     the adapter's [[number,url,state,base,head]] rows for the open PRs
#     --state merged | all                         canned/pr-merged.json (all adds the open PR); --state closed: none (a merged PR is not "closed")
#     --search ... or any other --jq                UNSUPPORTED (exit 2): the stub does not implement GitHub search syntax or jq
#   issue list, search issues, api search/issues   ERROR: "HTTP 503: Service Unavailable" (exit 1): issue search is down in this sandbox,
#                                                  so incidents cannot be listed and a run has to say so
# Anything that would change a pull request, an issue or the repository (create, merge, close, edit, comment, review, ..., or an api
# write method) is REFUSED, exit 2. Any other call is UNSUPPORTED, exit 2.
here=$(cd "$(dirname "$0")" && pwd)
canned="$here/canned"
log="$here/../../gh-calls.log"
line=$(printf '%s' "$*" | tr '\n\r' '  ' | cut -c1-4000)
note() { printf '%s %s\n' "$1" "$line" >> "$log"; }
refuse() { note REFUSED; echo "gh stub: refused (would change something): $*" >&2; exit 2; }
unsupported() { note UNSUPPORTED; echo "gh stub: unsupported call: $*" >&2; exit 2; }
down() { note ERROR; echo "HTTP 503: Service Unavailable (https://api.github.com/search/issues)" >&2; exit 1; }
all="$*"
has() { case "$all" in *"$1"*) return 0 ;; esac; return 1; }
state=open
prev=""
for a in "$@"; do
  case "$prev" in --state|-s) state=$a ;; esac
  case "$a" in --state=*) state=${a#--state=} ;; esac
  prev=$a
done

case "$1" in
  --version) note OK; echo "gh version 2.103.2 (stub)"; exit 0 ;;
  auth)
    if [ "$2" = status ]; then note OK; if has "--jq"; then echo true; else printf 'github.com\n  Logged in to github.com account retro-user (stub)\n'; fi; exit 0; fi
    refuse "$@" ;;
  repo)
    if [ "$2" = view ]; then
      if has "--jq"; then
        case "$all" in
          *"--jq .nameWithOwner"*|*"--jq '.nameWithOwner'"*) note OK; echo example-org/export-service; exit 0 ;;
          *"--jq .defaultBranchRef.name"*|*"--jq '.defaultBranchRef.name'"*) note OK; echo main; exit 0 ;;
        esac
        unsupported "$@"
      fi
      note OK; cat "$canned/repo-view.json"; exit 0
    fi
    refuse "$@" ;;
  pr)
    case "$2" in
      list)
        if has "--search" || has " -S"; then unsupported "$@"; fi
        if has "--jq"; then
          case "$all" in
            *"[.[] | [(.number|tostring), .url, .state, .baseRefName, .headRefName]]"*)
              if [ "$state" = open ]; then
                note OK; printf '[["31","https://github.com/example-org/export-service/pull/31","OPEN","main","feature/xlsx-export"]]\n'; exit 0
              fi ;;
          esac
          unsupported "$@"
        fi
        case "$state" in
          open) note OK; if has "--json"; then cat "$canned/pr-open.json"; else printf '31\tAdd XLSX export\tfeature/xlsx-export\tOPEN\n'; fi; exit 0 ;;
          merged) note OK; if has "--json"; then cat "$canned/pr-merged.json"; else printf '16\tHotfix timezone in the CSV header\tfix/csv-timezone\tMERGED\n'; fi; exit 0 ;;
          closed) note OK; if has "--json"; then echo '[]'; fi; exit 0 ;;
          all)
            if has "--json"; then
              note OK
              # the merged PRs, then the open one, as one array
              m=$(cat "$canned/pr-merged.json"); o=$(cat "$canned/pr-open.json")
              printf '%s\n' "$m" | sed '$d'; printf ',\n'; printf '%s\n' "$o" | sed '1d'
              exit 0
            fi
            unsupported "$@" ;;
        esac
        unsupported "$@" ;;
      view|diff|checks|status) unsupported "$@" ;;
    esac
    refuse "$@" ;;
  issue)
    case "$2" in
      list) down ;;
      view|status) unsupported "$@" ;;
    esac
    refuse "$@" ;;
  search) down ;;
  api)
    case "$all" in
      *mutation*|*" -X "*|*"--method"*|*" POST"*|*" PATCH"*|*" PUT"*|*" DELETE"*|*"--input"*|*"-f "*|*"-F "*) refuse "$@" ;;
      *"search/issues"*|*"/issues"*) down ;;
    esac
    unsupported "$@" ;;
esac
refuse "$@"
