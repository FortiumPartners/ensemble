#!/bin/sh
# Stub `bv` (beads viewer) for skill evals. Same conventions and environment variables as the sibling `br` stub (BR_STUB_CANNED for the
# canned directory; BV_STUB_LOG for the call log, default bv-calls.log in the sandbox root).
#   --version          "bv 0.1.0 (stub)"
#   --robot-plan ...   canned/bv-plan.json (the adapter passes `--format json`; the stub prints JSON whatever the flags)
#   --robot-insights   canned/bv-insights.json when that file exists, else refused
# Anything else: message on stderr, exit 2.
here=$(cd "$(dirname "$0")" && pwd)
canned="${BR_STUB_CANNED:-$here/canned}"
log="${BV_STUB_LOG:-$here/../../bv-calls.log}"
printf '%s\n' "$(printf '%s' "$*" | tr '\n\r' '  ')" >> "$log"
case "$1" in
  --version) echo "bv 0.1.0 (stub)"; exit 0 ;;
  --robot-plan) cat "$canned/bv-plan.json"; exit 0 ;;
  --robot-insights) if [ -f "$canned/bv-insights.json" ]; then cat "$canned/bv-insights.json"; exit 0; fi ;;
esac
echo "bv stub: unsupported call: $*" >&2
exit 2
