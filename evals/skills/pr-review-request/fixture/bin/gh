#!/bin/sh
# Stub `gh` for the pr-review-request eval: five open pull requests (12, 15, 18, 21, 27), answered from canned files in bin/canned/,
# no network and no GitHub. Read verbs answer; every verb that would change a pull request or the repository (review, comment,
# merge, edit, close, reopen, ready, create, checkout, api write) is REFUSED with exit 2; any call this stub does not know fails closed
# the same way. Every call is appended to gh-calls.log in the sandbox root (two levels above this stub, outside the git worktree),
# prefixed `OK` when answered, `REFUSED` when it would change something, `UNSUPPORTED` for any other call it cannot answer. Arguments are folded to one line so a crafted one cannot fake another call.
here=$(cd "$(dirname "$0")" && pwd)
canned="$here/canned"
log="$here/../../gh-calls.log"
line=$(printf '%s' "$*" | tr '\n\r' '  ')

# REFUSED = a verb that would change something; UNSUPPORTED = a read the stub has no canned answer for. Both exit 2.
refuse() {
  case "$1 $2" in
    "pr review"|"pr comment"|"pr merge"|"pr edit"|"pr close"|"pr reopen"|"pr ready"|"pr create"|"pr checkout"|"pr lock"|"pr unlock"|"pr update-branch"|"issue "*|"release "*|"label "*|"repo edit"|"repo delete"|"repo create"|"workflow run")
      printf 'REFUSED %s\n' "$line" >> "$log" ;;
    "api "*)
      case "$*" in
        *-X*|*--method*|*POST*|*PATCH*|*PUT*|*DELETE*|*mutation*|*" -f "*|*" -F "*|*--field*|*--raw-field*|*--input*) printf 'REFUSED %s\n' "$line" >> "$log" ;;
        *) printf 'UNSUPPORTED %s\n' "$line" >> "$log" ;;
      esac ;;
    *) printf 'UNSUPPORTED %s\n' "$line" >> "$log" ;;
  esac
  echo "gh stub: refused or unsupported call: $*" >&2
  exit 2
}
ok() { printf 'OK %s\n' "$line" >> "$log"; }

case "$*" in *--jq*) has_jq=1 ;; *) has_jq=0 ;; esac
case "$*" in *--json*) has_json=1 ;; *) has_json=0 ;; esac

case "$1" in
  --version) ok; echo "gh version 2.103.2 (stub)"; exit 0 ;;
  auth)
    case "$2" in status) ok; echo "github.com: Logged in as stub (stub)"; exit 0 ;; esac
    refuse "$@" ;;
  repo)
    case "$2" in view) ok; cat "$canned/repo-view.json"; exit 0 ;; esac
    refuse "$@" ;;
  pr)
    case "$2" in
      list)
        case "$*" in
          *--state*closed*|*--state*merged*|*--draft*) refuse "$@" ;;
        esac
        if [ "$has_jq" = 1 ]; then
          case "$*" in
            *"[.[] | [(.number|tostring), .url, .state, .baseRefName, .headRefName]]"*) ok; cat "$canned/pr-list-adapter.json"; exit 0 ;;
          esac
          refuse "$@"
        fi
        ok
        if [ "$has_json" = 1 ]; then cat "$canned/pr-list-objects.json"; else cat "$canned/pr-list.tsv"; fi
        exit 0 ;;
      view)
        n=$3
        case "$n" in 12|15|18|21|27) ;; *) refuse "$@" ;; esac
        if [ "$has_jq" = 1 ]; then
          case "$*" in
            *"[(.number|tostring), .url, .state, .baseRefName, .headRefName, .statusCheckRollup]"*) ok; cat "$canned/pr-view-adapter-$n.json"; exit 0 ;;
          esac
          refuse "$@"
        fi
        ok
        if [ "$has_json" = 1 ]; then cat "$canned/pr-view-object-$n.json"; else sed -n 's/.*"title": "\(.*\)",/title:\t\1/p' "$canned/pr-view-object-$n.json"; fi
        exit 0 ;;
      diff|checks|status) refuse "$@" ;;
    esac
    refuse "$@" ;;
esac
refuse "$@"
