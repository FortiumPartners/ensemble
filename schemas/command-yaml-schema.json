{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sunstonepartners.com/schemas/command-yaml-schema.json",
  "title": "Ensemble Command YAML Schema",
  "description": "Schema for validating ensemble plugin command YAML files. A command is one of two shapes: a full command (metadata, mission, workflow, ...) or a skill-backed manifest (metadata and skill only, the prompt living in the skill's SKILL.md).",
  "type": "object",
  "additionalProperties": true,
  "required": ["metadata"],
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["name", "description", "version"],
      "additionalProperties": true,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*(:[a-z][a-z0-9-]*)?$",
          "description": "Command name (lowercase, hyphenated, optionally namespaced with colon)"
        },
        "description": {
          "type": "string",
          "minLength": 10,
          "maxLength": 200,
          "description": "Brief description of command purpose"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "description": "Semantic version (e.g., 1.0.0)"
        },
        "lastUpdated": {
          "type": "string",
          "format": "date",
          "description": "ISO 8601 date of last update"
        },
        "category": {
          "type": "string",
          "enum": ["analysis", "workflow", "infrastructure", "quality", "documentation", "git", "testing", "planning", "implementation", "deployment", "configuration"],
          "description": "Command category"
        },
        "output_path": {
          "type": "string",
          "description": "Optional custom output path"
        },
        "source": {
          "type": "string",
          "description": "Source organization"
        },
        "allowed_tools": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Tools this command can use"
        },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "description": "Toolchain capability ids this command relies on, cross-referenced against packages/development/toolchain/categories/*.yaml by scripts/validate-all.js",
          "properties": {
            "required": {
              "type": "array",
              "items": { "type": "string", "pattern": "^[a-z-]+\\.[a-z-]+$" },
              "description": "Capability ids this command cannot run without"
            },
            "optional": {
              "type": "array",
              "items": { "type": "string", "pattern": "^[a-z-]+\\.[a-z-]+$" },
              "description": "Capability ids this command uses when available, with a documented fallback otherwise"
            }
          }
        },
        "argument_hint": {
          "type": "string",
          "description": "Hint for command arguments"
        },
        "model": {
          "type": "string",
          "enum": ["high", "medium", "low"],
          "description": "Preferred Claude model for this command"
        },
        "visibility": {
          "type": "string",
          "enum": ["visible", "hidden"],
          "default": "visible",
          "description": "Slash-menu visibility. 'hidden' keeps the command generated and readable by path (dispatchers invoke it) but removes it from the user-facing command surface on every runtime. Defaults to 'visible'."
        }
      }
    },
    "skill": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Makes this command a skill-backed manifest: the directory name of the skill, in this same package (packages/<pkg>/skills/<skill>/SKILL.md), whose body is the command's prompt and single source of truth. A manifest carries only `metadata` and `skill` (mission, workflow, constraints, parameters, expectedOutput and the rest belong in the skill) and each runtime emits a thin entry point that points at the skill. That the skill exists is checked by scripts/lib/schema-validator.js."
    },
    "mission": {
      "type": "object",
      "required": ["summary"],
      "additionalProperties": true,
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 20,
          "description": "Detailed mission summary"
        }
      }
    },
    "workflow": {
      "type": "object",
      "required": ["phases"],
      "additionalProperties": true,
      "properties": {
        "phases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "order"],
            "additionalProperties": true,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 3,
                "description": "Phase name"
              },
              "order": {
                "type": "integer",
                "minimum": 1,
                "description": "Phase execution order (must be sequential from 1)"
              },
              "steps": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["order"],
                  "additionalProperties": true,
                  "properties": {
                    "order": {
                      "oneOf": [
                        { "type": "integer", "minimum": 1 },
                        { "type": "string", "pattern": "^[0-9]+[a-z]?$" }
                      ],
                      "description": "Step execution order (integer or string like '3a' for sub-steps)"
                    },
                    "title": {
                      "type": "string",
                      "description": "Step title"
                    },
                    "description": {
                      "type": "string",
                      "description": "Step description"
                    },
                    "actions": {
                      "type": "array",
                      "items": { "type": "string" },
                      "description": "List of actions to perform"
                    },
                    "delegation": {
                      "type": "object",
                      "properties": {
                        "agent": {
                          "type": "string",
                          "description": "Agent to delegate to"
                        },
                        "context": {
                          "type": "string",
                          "description": "Context for delegation"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "dispatch": {
      "type": "object",
      "additionalProperties": true,
      "required": ["subcommands"],
      "description": "Marks this command as a thin dispatcher that routes to sibling commands by keyword",
      "properties": {
        "subcommands": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["keyword", "ref"],
            "additionalProperties": true,
            "properties": {
              "keyword": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$",
                "description": "First-argument token the user types to select this subcommand"
              },
              "ref": {
                "type": "string",
                "description": "Referenced sibling command's metadata.name with the 'ensemble:' prefix stripped"
              },
              "description": {
                "type": "string",
                "description": "Optional override; defaults to the referenced command's own description"
              }
            }
          }
        }
      }
    },
    "expectedOutput": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "format": {
          "type": "string",
          "description": "Expected output format"
        },
        "structure": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "description": { "type": "string" }
            }
          }
        }
      }
    }
  },
  "if": { "required": ["skill"] },
  "then": {
    "properties": { "metadata": {}, "skill": {} },
    "additionalProperties": false
  },
  "else": { "required": ["mission", "workflow"] }
}
