{
  "name": "@sunstone-partners/ensemble-pi-extension",
  "version": "0.1.2",
  "description": "Thin Pi-specific extension providing native command completion for the prd/trd/issue/feature dispatcher commands via Pi's native extension mechanism",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/",
    "README.md",
    "CHANGELOG.md",
    "src/"
  ],
  "scripts": {
    "prebuild": "tsc -p ../agent-core",
    "build": "tsc",
    "pretest": "tsc -p ../agent-core",
    "test": "jest",
    "pretest:smoke": "tsc -p ../agent-core",
    "test:smoke": "node scripts/smoke-activate.mjs",
    "test:smoke:lifecycle": "node scripts/smoke-lifecycle.mjs",
    "preinstall:extension": "tsc -p ../agent-core",
    "install:extension": "node scripts/install.mjs",
    "uninstall:extension": "node scripts/install.mjs --uninstall"
  },
  "keywords": [
    "ensemble",
    "pi-extension"
  ],
  "author": {
    "name": "Sunstone Partners",
    "email": "info@sunstonepartners.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sunstone-Partners/ensemble.git",
    "directory": "packages/pi-extension"
  },
  "homepage": "https://github.com/Sunstone-Partners/ensemble/tree/main/packages/pi-extension",
  "bugs": {
    "url": "https://github.com/Sunstone-Partners/ensemble/issues"
  },
  "engines": {
    "node": ">=22.19.0",
    "pi": ">=0.87.0"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.87.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.87.1",
    "@types/jest": "^29.0.0",
    "@types/js-yaml": "^4.0.0",
    "@types/node": "^20.0.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "typescript": "^5.0.0"
  },
  "pi": {
    "extensions": [
      "./src/extension.ts"
    ]
  }
}
