{
  "name": "@sunstone-partners/ensemble-pi",
  "version": "1.6.6",
  "description": "Pi runtime support — translates ensemble artifacts for Pi coding agent",
  "main": "dist/index.js",
  "files": [
    "dist/",
    "skills/",
    "prompts/",
    "agents/",
    "vendor/",
    ".claude-plugin/",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "generate": "node dist/index.js",
    "validate:version": "node -e \"const p=require('./package.json'); const c=require('./.claude-plugin/plugin.json'); if(p.version!==c.version){process.stderr.write('Version mismatch: package.json ('+p.version+') != plugin.json ('+c.version+')\\n'); process.exit(1)}\"",
    "prepublishOnly": "npm run build && npm test && npm run validate:version && npm run generate"
  },
  "keywords": [
    "pi-package",
    "ensemble",
    "ai-agents"
  ],
  "author": {
    "name": "Sunstone Partners",
    "email": "info@sunstonepartners.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sunstone-Partners/ensemble.git",
    "directory": "packages/pi"
  },
  "homepage": "https://github.com/Sunstone-Partners/ensemble/tree/main/packages/pi",
  "bugs": {
    "url": "https://github.com/Sunstone-Partners/ensemble/issues"
  },
  "pi": {
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts"
    ],
    "agents": [
      "./agents"
    ]
  },
  "engines": {
    "node": ">=18.0.0",
    "pi": ">=1.0.0"
  },
  "dependencies": {
    "@sunstone-partners/ensemble-core": "^5.4.0",
    "glob": "^10.0.0",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/jest": "^29.0.0",
    "@types/js-yaml": "^4.0.0",
    "@types/node": "^20.0.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "typescript": "^5.0.0"
  }
}
