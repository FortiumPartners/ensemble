node_modules/
coverage/
*.log
.DS_Store
*.tgz
dist/
build/
.npmrc.local
*.backup

# Python cache files
__pycache__/
*.pyc
*.pyo


# Dolt database files (added by bd init)
.dolt/
*.db

# bv (beads viewer) local config and caches
.bv/

# Tool state directories
.beads.bd/
.mulch/
.ntm/
.opencode/
.todos/
.claude/worktrees/

# Foreman runtime artifacts
.foreman/

# Beads local issue database — tracked in git when Dolt sync is unavailable
# (no `dolt` CLI on this machine, no remote configured). The local JSONL
# export from `br sync --flush-only` is the canonical accessible record.
# The lock files below are per-process runtime state, never part of that record.
.beads/*.db-lock-*
.beads/*.db-wal-lock-*

# Fork-local operating notes, loaded by Claude Code alongside CLAUDE.md
CLAUDE.local.md
.ensemble/runtime-log.jsonl
.ensemble/*/active.lock
.ensemble/state/

# Untracked, resumable PR-review-cycle state reports (TRD-007/TRD-008):
# committing one would change the PR head SHA and invalidate the very
# review it records.
.ensemble/pr-review/

# Local CI gate (TRD-012): throwaway clean clones of PR heads, and the optional
# local secrets file the runner reads. Neither may ever be committed; the runner
# also refuses a secrets file that git tracks or does not ignore.
.ensemble/local-ci-runs/
.ensemble/local-ci.secrets.env

# The installed bundle's vendored runtime dependencies, which have to be IN the repo
# because `claude plugin install` copies the plugin directory and never runs
# `npm install`. They sit under lib/ rather than at packages/full/ because npm manages
# a workspace's own node_modules and prunes anything it did not put there: a tree at
# packages/full/node_modules is deleted by the next `npm install` (measured on this
# repo, nine packages to zero in one run), while this path survives it.
#
# This block is LAST on purpose. Negations are beaten by any later matching pattern,
# and `dist/`, `coverage/` and `*.log` above all match paths inside a vendored package.
# With the block at the top of this file, ajv's own entry point -- dist/ajv.js -- was
# excluded, so the tree worked from the untracked files on disk and a fresh clone would
# have got a broken package.
#
# Refresh with `node scripts/vendor-bundle-deps.js`; see that directory's README.md.
!packages/full/lib/node_modules/
!packages/full/lib/node_modules/**

